# Local LLM
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_KEEP_ALIVE=30m
OLLAMA_STRUCTURED_OUTPUT=true

# 실제 API 테스트 시 false
USE_MOCK_PLACES=false
PROVIDER_TIMEOUT_SECONDS=5

# Kakao Local REST API
KAKAO_REST_API_KEY=

# Naver Search Local API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 공공데이터포털 일반 인증키 1개
# Encoding/Decoding 키 어느 쪽을 넣어도 동작하도록 처리함
PUBLIC_DATA_API_KEY=

# 아래 URL은 사용할 공공데이터 API 페이지를 확인한 뒤 연결
BUSAN_API_URL=
TOUR_API_URL=
KMA_API_URL=
